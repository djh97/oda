# Copy this file to .env and fill in values.
# NEVER commit .env

# Network selection (used by config to pick integration/addresses/<network>.json)
NETWORK=sepolia

# Sepolia RPC (Infura / Alchemy / your provider)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Etherscan source-code verification. Create a key in your Etherscan account.
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Hosted comparator. Leave unset unless reproducing that evaluation condition.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL_ID=gpt-4o-mini-2024-07-18

# Pinata (encrypted profile and decision-artifact uploads + gateway reads)
PINATA_JWT=YOUR_PINATA_JWT
PINATA_GATEWAY=https://YOUR_GATEWAY.mypinata.cloud/ipfs/

# URL-safe base64 encoding of exactly 32 random bytes. Generate with:
# python -m evaluation.generate_encryption_key
OFFCHAIN_ENCRYPTION_KEY=YOUR_URLSAFE_BASE64_32_BYTE_KEY

# ---- Private keys (NEVER COMMIT REAL VALUES) ----
# Used by middleware to sign createMatch() as the authorized decision service.
DECISION_SERVICE_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Synthetic workflow actors. The canonical evidence run requires a distinct,
# funded Sepolia account for each entry. These accounts demonstrate software
# authorization paths; they do not represent actual people or clinical review.
REGULATOR_PRIVATE_KEY=0x...
HOSPITAL_PRIVATE_KEY=0x...
ETHICS_PRIVATE_KEY=0x...
MEDICAL_PRIVATE_KEY=0x...
DONOR_PRIVATE_KEY=0x...

# Recipients. All ten keys must be distinct because their addresses are bound
# to separate synthetic identities. Only the guarded primary signs the full
# demonstration, but funding all ten avoids a funding stop if model output
# changes which recipient is selected.
RECIPIENT1_PRIVATE_KEY=0x...
RECIPIENT2_PRIVATE_KEY=0x...
RECIPIENT3_PRIVATE_KEY=0x...
RECIPIENT4_PRIVATE_KEY=0x...
RECIPIENT5_PRIVATE_KEY=0x...
RECIPIENT6_PRIVATE_KEY=0x...
RECIPIENT7_PRIVATE_KEY=0x...
RECIPIENT8_PRIVATE_KEY=0x...
RECIPIENT9_PRIVATE_KEY=0x...
RECIPIENT10_PRIVATE_KEY=0x...

# Optional transaction knobs
TX_PRIORITY_FEE_GWEI=2
TX_RECEIPT_TIMEOUT_S=600
TX_POLL_LATENCY_S=2
