# Copy this file to .env and fill in values.
# NEVER commit .env

# Network selection (used by config to pick integration/addresses/<network>.json)
NETWORK=sepolia

# Sepolia RPC (Infura / Alchemy / your provider)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Optional deployment / manifest helpers used by evaluation scripts
DEPLOYMENT_TX_HASH=0xYOUR_DEPLOYMENT_TX_HASH
LOGS_FROM_BLOCK=
LOGS_TO_BLOCK=

# OpenAI (LLM decision support)
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_MODEL_ID=ft:gpt-4o-mini-...

# Pinata (match rationale upload + gateway reads)
PINATA_JWT=YOUR_PINATA_JWT
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ---- Private keys (NEVER COMMIT REAL VALUES) ----
# Used by pipeline to sign createMatch() as the authorized LLM EOA
LLM_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Used by seeding script
REGULATOR_PRIVATE_KEY=0x...
HOSPITAL_PRIVATE_KEY=0x...
ETHICS_PRIVATE_KEY=0x...
MEDICAL_PRIVATE_KEY=0x...
DONOR_PRIVATE_KEY=0x...

# Recipients (add up to 10 for current seeder)
RECIPIENT1_PRIVATE_KEY=0x...
RECIPIENT2_PRIVATE_KEY=0x...
RECIPIENT3_PRIVATE_KEY=0x...
RECIPIENT4_PRIVATE_KEY=0x...
RECIPIENT5_PRIVATE_KEY=0x...
RECIPIENT6_PRIVATE_KEY=0x...
RECIPIENT7_PRIVATE_KEY=0x...
RECIPIENT8_PRIVATE_KEY=0x...
RECIPIENT9_PRIVATE_KEY=0x...
RECIPIENT10_PRIVATE_KEY=0x...

# ---- Seed CIDs (synthetic is fine) ----
SEED_DONOR_CID=bafk...
SEED_RECIPIENT1_CID=bafk...
SEED_RECIPIENT2_CID=bafk...
SEED_RECIPIENT3_CID=bafk...
SEED_RECIPIENT4_CID=bafk...
SEED_RECIPIENT5_CID=bafk...
SEED_RECIPIENT6_CID=bafk...
SEED_RECIPIENT7_CID=bafk...
SEED_RECIPIENT8_CID=bafk...
SEED_RECIPIENT9_CID=bafk...
SEED_RECIPIENT10_CID=bafk...

# Optional evaluation / benchmark knobs
BENCH_DONOR_ID=1
BENCH_RUNS=10
BENCH_CHAIN_RUNS=3
MATCH_RATIONALE_CID=cid-placeholder
FOUNDRY_ARTIFACT_PATH=
TX_MAX_FEE_GWEI=60
TX_PRIORITY_FEE_GWEI=3
TX_RECEIPT_TIMEOUT_S=600
TX_POLL_LATENCY_S=2
